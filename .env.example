# Copy this file to .env and fill in real values. Never commit .env.

# NeuPrint (only needed if the connectome cache described in the README
# doesn't exist yet -- every normal run loads from that cache instead).
NEUPRINT_TOKEN=
NEUPRINT_HOST=neuprint.janelia.org

# Supabase (leaderboard + match history). Use the *secret* (service_role)
# key here, not the publishable/anon key -- this file is only ever read by
# the trusted backend, never shipped to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
