# Copy this file to .env and fill in real values. Never commit .env.

# NeuPrint -- only needed to regenerate the pruned connectome cache (see the
# README's "Connectome cache" section). The server itself never reads these;
# it only ever loads the pre-built pruned cache already committed in-repo.
NEUPRINT_TOKEN=
NEUPRINT_HOST=neuprint.janelia.org

# Supabase (leaderboard + match history). Use the *secret* (service_role)
# key here, not the publishable/anon key -- this file is only ever read by
# the trusted backend, never shipped to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
